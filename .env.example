APP_NAME="Dunia Media"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=duniamedia
# DB_USERNAME=root
# DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@duniamedia.com"
MAIL_FROM_NAME="Dunia Media"

# AWS S3 client media (optional; keep WORK_MEDIA_DISK=local for local files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-5
AWS_BUCKET=duniamedia-client-media
AWS_USE_PATH_STYLE_ENDPOINT=false
WORK_MEDIA_DISK=local
WORK_MEDIA_PREFIX=client-work
WORK_MEDIA_URL_TTL=120
