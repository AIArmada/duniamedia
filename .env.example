APP_NAME="Dunia Media"
APP_ENV=local

# Seeded admin account. Leave ADMIN_PASSWORD blank to generate one on first seed.
ADMIN_NAME="Dunia Media Admin"
ADMIN_EMAIL=admin@duniamedia.test
ADMIN_PASSWORD=

APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=duniamedia
# DB_USERNAME=root
# DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
LOG_CHANNEL=stack
LOG_LEVEL=debug
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@duniamedia.com"
MAIL_FROM_NAME="Dunia Media"

# AWS S3 client media (optional; keep WORK_MEDIA_DISK=local for local files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-5
AWS_BUCKET=duniamedia-client-media
AWS_USE_PATH_STYLE_ENDPOINT=false
WORK_MEDIA_DISK=local
WORK_MEDIA_PREFIX=client-work
WORK_MEDIA_URL_TTL=120

# Media advisor AI assistance (optional; deterministic engine always runs)
ADVISOR_AI_ENABLED=false
ADVISOR_AI_PROVIDER=
ADVISOR_AI_MODEL=
ADVISOR_AI_TIMEOUT=45

# Commerce package owner scoping
ADDRESSING_OWNER_ENABLED=false
CONTACTING_OWNER_ENABLED=false
PERSONS_ADDRESSING_ENABLED=true

# Cloudflare Turnstile (contact form requires valid keys; never commit the secret)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
